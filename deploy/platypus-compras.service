[Unit]
Description=Platypus - Compras (platypus-compras): revision de facturas de proveedores
After=network-online.target
Wants=network-online.target

[Service]
User=rene
Group=rene
WorkingDirectory=/opt/interfuerza/platypus-compras
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/interfuerza/platypus-compras/.venv/bin/uvicorn compras.web.app:app --host 127.0.0.1 --port 8400 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/interfuerza/platypus-compras/data
MemoryMax=200M

[Install]
WantedBy=multi-user.target
